<Project Sdk="Microsoft.NET.Sdk">
  <!-- 설치 프로그램 (exe 하나에 CorridorSolids.bundle을 넣어 둔다)
       빌드: 먼저 플러그인 dll을 ..\CorridorSolids.bundle\Contents 에 넣은 뒤
       dotnet publish setup\CorridorSolidsSetup.csproj -c Release -o <출력폴더>
       → CorridorSolids.exe (Civil 3D 2026이 깔린 PC에는 .NET 8 데스크톱 런타임이 있으므로 따로 설치할 것 없음) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>CorridorSolids</AssemblyName>
    <RootNamespace>CorridorSolidsSetup</RootNamespace>
    <ApplicationIcon>corsolid.ico</ApplicationIcon>
    <Product>코리더 솔리드 일괄 추출 설치</Product>
    <Version>1.4.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\CorridorSolids.bundle\**\*" LogicalName="bundle/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="corsolid.ico" LogicalName="corsolid.ico" />
  </ItemGroup>
</Project>
